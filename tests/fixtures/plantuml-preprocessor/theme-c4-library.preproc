skinparam backgroundColor transparent
skinparam useBetaStyle false






<style>
  root {
    BackgroundColor transparent
    FontColor #fff
    HyperLinkColor #e95420
    LineColor #d24c1d
    LineThickness 1
    Margin 10
    Padding 6
    Shadowing 0.0
  }
  node {
   Padding 15
   roundcorner 20
   BackgroundColor #e95420-#d24c1d
  }
  caption {
    LineThickness 0
  }
  footer {
    LineThickness 0
  }
  groupHeader {
    BackgroundColor #aea79f
    FontColor #17a2b8
    FontStyle bold
  }
  header {
    LineThickness 0
  }
  referenceHeader {
    BackgroundColor transparent
    FontColor #772953
    FontStyle bold
  }
  separator {
    BackgroundColor #fff
    FontColor transparent
    FontStyle bold
  }
  title {
	FontSize 20
	BorderRoundCorner            8
	BorderThickness 	         1
	BackgroundColor  #b6b0a9-#aea79f
	FontColor #e95420
	BorderColor #aea79f
  }
  nwdiagDiagram {
	network {
			FontColor #fff
	BorderColor #d24c1d
	BackgroundColor #e95420    
		LineColor #e95420
		LineThickness 1.0
		FontColor #d24c1d
	}
	server {
			FontColor #fff
	BorderColor #d24c1d
	BackgroundColor #e95420
	}
	arrow {
		FontColor #d24c1d
		LineColor #d24c1d
	}
	group {
		BackGroundColor #e9ecef
		LineColor #d2d4d7
		LineThickness 2.0
		Margin 5
		Padding 5
	}
  }
  participant {
    Margin 5 40
    Padding 15 20
  }
  ganttDiagram {
	task {
			FontColor #fff
	BorderColor #d24c1d
	BackgroundColor #e95420
		LineColor #e95420
		Margin 10 2 2 2
		Padding 6
	}
	note {
		FontColor #fff
		LineColor #1592a6
		BackGroundColor #17a2b8
	}
	separator {
		LineColor #aea79f
		BackGroundColor #aea79f-#9d968f
		FontColor #fff
	}
	milestone {
		FontColor #17a2b8
		FontSize 16
		FontStyle italic
		BackGroundColor #aea79f
		LineColor #9d968f
	}
	timeline {
		BackgroundColor #aea79f
		FontColor #fff
	}
	closed {
		BackgroundColor #d7a538
		FontColor #fff
	}
  }
</style>
skinparam defaultFontName       "Verdana"
skinparam defaultFontSize       12
skinparam dpi                   100
skinparam shadowing             false
skinparam roundcorner           8
skinparam BoxPadding            40
skinparam ArrowColor            #772953
skinparam stereotype {
    CBackgroundColor #b6b0a9
    CBorderColor #9d968f
    ABackgroundColor #4cbc5c
    ABorderColor #32a243
    IBackgroundColor #e24c41
    IBorderColor #c93228
    EBackgroundColor #f1be51
    EBorderColor #d7a538
    NBackgroundColor #2eabbf
    NBorderColor #1592a6
}
skinparam title {
	FontColor	                 #e95420
	BorderColor	                 #9d968f
	FontSize	    	         20
	BorderRoundCorner            8
	BorderThickness 	         1
	BackgroundColor              #b6b0a9-#aea79f
}

