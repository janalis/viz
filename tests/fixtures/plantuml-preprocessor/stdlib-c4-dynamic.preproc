skinparam maxMessageSize 150

skinparam StereotypeAlignment right

skinparam lineType curve






<style>
    archimate {
        RoundCorner 1
    }
    arrow {
        LineColor #Black
        FontColor #Black
        FontSize 10
    }
    element {
        FontName Verdana
        FontSize 12
        MaximumWidth 600
        MinimumWidth 120
        HorizontalAlignment center
        stereotype {
            HorizontalAlignment right
        }
    }
    folder {
        .group {
            BackgroundColor #LightGrey
            Shadowing 2
            stereotype {
                FontSize 1
                FontColor transparent
            }

        }
        .grouping {
            LineColor #444444
            LineStyle 8-5
            Shadowing 2
            stereotype {
                FontSize 1
                FontColor transparent
            }
        }
    }
    rectangle {
        .boundary {
            LineColor #444444
            LineStyle 8-5
            Shadowing 0
            stereotype {
                FontSize 1
                FontColor transparent
            }
        }
        RoundCorner 1
    }
    root {
        BackgroundColor #white
    }
    .application-event {
        RoundCorner 25
    }
    .application-function {
        RoundCorner 25
    }
    .application-interaction {
        RoundCorner 25
    }
    .application-process {
        RoundCorner 25
    }
    .application-service {
        RoundCorner 25
    }
    .business-event {
        RoundCorner 25
    }
    .business-function {
        RoundCorner 25
    }
    .business-interaction {
        RoundCorner 25
    }
    .business-process {
        RoundCorner 25
    }
    .business-service {
        RoundCorner 25
    }
    .implementation-event {
        RoundCorner 25
    }
    .implementation-workpackage {
        RoundCorner 25
    }
    .motivation-assessment {
        DiagonalCorner 12
    }
    .motivation-constraint {
        DiagonalCorner 12
    }
    .motivation-driver {
        DiagonalCorner 12
    }
    .motivation-goal {
        DiagonalCorner 12
    }
    .motivation-meaning {
        DiagonalCorner 12
    }
    .motivation-outcome {
        DiagonalCorner 12
    }
    .motivation-principle {
        DiagonalCorner 12
    }
    .motivation-requirement {
        DiagonalCorner 12
    }
    .motivation-stakeholder {
        DiagonalCorner 12
    }
    .motivation-value {
        DiagonalCorner 12
    }
    .service-special {
        RoundCorner 80
        stereotype {
            FontSize 1
            FontColor transparent
        }
    }
    .strategy-capability {
        RoundCorner 25
    }
    .strategy-courseofaction {
        RoundCorner 25
    }
    .strategy-valuestream {
        RoundCorner 25
    }
    .technology-event {
        RoundCorner 25
    }
    .technology-function {
        RoundCorner 25
    }
    .technology-interaction {
        RoundCorner 25
    }
    .technology-process {
        RoundCorner 25
    }
    .technology-service {
        RoundCorner 25
    }

</style>





























hide stereotype
legend right
|<color:#000000>**Legend**</color> |
|<#08427B> person |
|<#1168BD> system |
|<#438DD5> container |
|<#85BBF0> component |
|<#686868> external person |
|<#999999> external system |
|<#B3B3B3> external container |
|<#CCCCCC> external component |
endlegend
rectangle "<$person2>\n== Admin\n\nthe admin" <<person>> as a 
  rectangle "== Boundary\n<size:12>[container]</size>" <<container_boundary>><<boundary>> as b  {
    rectangle "== API\n//<size:12>[PHP]</size>//\n\nServes" <<container>> as c 
    database "== DB\n//<size:12>[Postgres]</size>//" <<container>> as d 
}
a -->> c : **1: Calls**\n//<size:12>[HTTPS]</size>//
c -RIGHT->> d : **2: Reads**
@enduml
